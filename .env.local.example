# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/trader"

# ── Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Base URL (no trailing slash)
AUTH_URL="http://localhost:3000"

# ── AI provider ───────────────────────────────────────────────────────
# Set AI_PROVIDER=anthropic to use Claude for playbook generation.
# Without this (or with an unrecognised value), the mock provider is used.
AI_PROVIDER="anthropic"

# Anthropic API key — required when AI_PROVIDER=anthropic.
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the Claude model used for generation.
# Defaults to claude-haiku-4-5-20251001 (fast, cost-effective).
# For higher quality at higher cost: claude-sonnet-4-6
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
