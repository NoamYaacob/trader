# Copy this file to .env.local and fill in the required values.
# .env.local is never committed (see .gitignore).

# ── Database ──────────────────────────────────────────────────────────
# Required. PostgreSQL connection string.
# Local example:  postgresql://postgres:password@localhost:5432/trader
# Docker example: postgresql://postgres:password@localhost:5432/trader
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/trader"

# ── Auth ──────────────────────────────────────────────────────────────
# Required. Generate a secret with: openssl rand -base64 32
AUTH_SECRET="your-generated-secret-here"

# Required. Base URL of the app (no trailing slash).
AUTH_URL="http://localhost:3000"

# ── AI provider ───────────────────────────────────────────────────────
# Optional. Without this block the built-in mock provider is used —
# playbook generation works offline with no API key.
#
# To enable Claude:
# AI_PROVIDER="anthropic"
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"   # optional, this is the default
