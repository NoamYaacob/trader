# Copy this file to .env.local and fill in the required values.
# .env.local is gitignored and never committed.

# ── Database ──────────────────────────────────────────────────────────
# Required. PostgreSQL connection string.
# Local:  postgresql://postgres:password@localhost:5432/trader
# Docker: postgresql://postgres:password@localhost:5432/trader
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/trader"

# ── Auth ──────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET="your-generated-secret-here"

# Required. Base URL (no trailing slash). Use localhost:3000 for local dev.
AUTH_URL="http://localhost:3000"

# ── AI provider ───────────────────────────────────────────────────────
# Optional. Without this the built-in mock provider is used —
# playbook generation works offline, no API key needed.
#
# To use Claude for real generation:
# AI_PROVIDER="anthropic"
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"   # optional, this is the default
