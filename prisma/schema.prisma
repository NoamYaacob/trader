generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Auth — NextAuth required models
// ─────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  hashedPassword String?
  role           UserRole  @default(USER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  strategies       Strategy[]
  trainingSessions TrainingSession[]
  tradeReviews     TradeReview[]
  // PropGuard relations
  traderProfile    TraderProfile?
  propFirmAccounts PropFirmAccount[]
  guardrails       Guardrails[]
  tradingSessions  TradingSession[]
  disciplineEvents DisciplineEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// Domain — Strategy & Playbook system
// ─────────────────────────────────────────────

enum StrategyStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  ACTIVE
  ARCHIVED
  FAILED
}

model Strategy {
  id     String @id @default(cuid())
  userId String

  // Intake fields — filled incrementally during onboarding
  instrument             String? @db.Text
  timeframe              String? @db.Text
  overview               String? @db.Text
  entryConditions        String? @db.Text
  exitConditions         String? @db.Text
  invalidationConditions String? @db.Text
  riskRules              String? @db.Text
  whatMakesValid         String? @db.Text
  whatMakesInvalid       String? @db.Text

  // Onboarding progress tracking
  intakeStep Int            @default(1)
  status     StrategyStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  playbooks Playbook[]
}

enum PlaybookStatus {
  DRAFT
  CONFIRMED
  ARCHIVED
}

model Playbook {
  id                String         @id @default(cuid())
  userId            String
  strategyId        String
  version           Int            @default(1)
  summary           String?        @db.Text
  status            PlaybookStatus @default(DRAFT)
  confirmedAt       DateTime?
  // AI-generated Pine Script indicator for this playbook version.
  // null until the playbook is generated; may be absent if the strategy is
  // too ambiguous for code generation (see pineScriptNotes for the reason).
  pineScript        String?        @db.Text
  pineScriptNotes   String?        @db.Text
  // Normalized strategy spec derived by the AI from free-text intake.
  // Stored as JSON — typed as StrategySpec in the application layer.
  // Null for playbooks generated before the spec layer was introduced.
  spec              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strategy         Strategy          @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  rules            Rule[]
  setups           Setup[]
  trainingSessions TrainingSession[]
  tradeReviews     TradeReview[]

  @@unique([strategyId, version])
}

enum RuleCategory {
  ENTRY
  EXIT
  INVALIDATION
  RISK
  MINDSET
}

enum RuleSource {
  AI_GENERATED
  TRADER_ADDED
}

model Rule {
  id          String       @id @default(cuid())
  playbookId  String
  text        String       @db.Text
  category    RuleCategory
  source      RuleSource   @default(AI_GENERATED)
  inChecklist Boolean      @default(false)
  order       Int          @default(0)

  createdAt DateTime @default(now())

  playbook      Playbook        @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  adherenceRows RuleAdherence[]
}

model Setup {
  id                    String  @id @default(cuid())
  playbookId            String
  userId                String
  name                  String
  description           String? @db.Text
  entryCondition        String? @db.Text
  exitCondition         String? @db.Text
  invalidationCondition String? @db.Text
  tags                  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playbook Playbook       @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  examples SetupExample[]
  reviews  TradeReview[]
}

enum ExampleClassification {
  VALID
  INVALID
}

model SetupExample {
  id             String                @id @default(cuid())
  setupId        String
  imageUrl       String
  annotationData Json?
  classification ExampleClassification
  notes          String?               @db.Text

  createdAt DateTime @default(now())

  setup    Setup            @relation(fields: [setupId], references: [id], onDelete: Cascade)
  attempts TrainingAttempt[]
}

// ─────────────────────────────────────────────
// Training sessions
// ─────────────────────────────────────────────

model TrainingSession {
  id           String    @id @default(cuid())
  userId       String
  playbookId   String
  // Shuffled list of SetupExample IDs — determines presentation order.
  exampleOrder String[]
  score        Int?      // null until completed; 0–100
  totalCount   Int       @default(0)
  correctCount Int       @default(0)
  completedAt  DateTime?

  createdAt DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  playbook Playbook          @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  attempts TrainingAttempt[]
}

model TrainingAttempt {
  id         String                @id @default(cuid())
  sessionId  String
  exampleId  String
  userAnswer ExampleClassification
  isCorrect  Boolean
  answeredAt DateTime              @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  example SetupExample    @relation(fields: [exampleId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Trade Review — post-trade execution audit
// ─────────────────────────────────────────────

enum TradeDirection {
  LONG
  SHORT
}

enum ReviewStatus {
  DRAFT
  COMPLETE
}

enum AdherenceStatus {
  FOLLOWED
  BROKE
  NA
}

model TradeReview {
  id             String         @id @default(cuid())
  userId         String
  playbookId     String
  setupId        String?        // Optional link to a Setup

  instrument     String
  direction      TradeDirection
  tradeDate      DateTime
  notes          String?        @db.Text

  adherenceScore Int?           // 0–100, null until COMPLETE
  status         ReviewStatus   @default(DRAFT)
  completedAt    DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  playbook  Playbook        @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  setup     Setup?          @relation(fields: [setupId], references: [id], onDelete: SetNull)
  adherence RuleAdherence[]
}

model RuleAdherence {
  id           String          @id @default(cuid())
  reviewId     String
  ruleId       String
  // Snapshot of rule text + category at time of review — survives playbook edits.
  ruleText     String          @db.Text
  ruleCategory RuleCategory
  status       AdherenceStatus @default(NA)
  notes        String?         @db.Text

  review TradeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  rule   Rule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// PropGuard — Discipline & risk protection
// ─────────────────────────────────────────────

enum TraderType {
  SCALPER
  INTRADAY
  SWING
}

enum TraderGoal {
  PASS_EVAL
  PROTECT_FUNDED
  REACH_PAYOUT
  IMPROVE_DISCIPLINE
}

enum PropProductType {
  EVALUATION
  FUNDED
  EXPRESS
}

enum SessionStatus {
  ACTIVE
  COMPLETED
}

enum AccountSafetyStatus {
  SAFE
  WARNING
  DANGER
}

enum DisciplineEventType {
  OVERTRADING_WARNING
  RAPID_FIRE_WARNING
  DAILY_LOSS_WARNING
  DAILY_LOSS_CRITICAL
  LOSS_STREAK_WARNING
  OUTSIDE_HOURS_WARNING
  PAYOUT_VIOLATION_WARNING
  COOLDOWN_TRIGGERED
  MANUAL_NOTE
}

enum DisciplineSeverity {
  INFO
  WARNING
  CRITICAL
}

model PropFirmTemplate {
  id               String  @id @default(cuid())
  name             String  @unique   // internal slug: "apex", "topstep", etc.
  displayName      String
  defaultDailyLoss Float?            // reference loss limit for a $50k account
  eodFlatRule      Boolean @default(false)
  trailingDrawdown Boolean @default(false)
  consistencyRule  Boolean @default(false)
  payoutAvailable  Boolean @default(true)
  notes            String? @db.Text

  accounts PropFirmAccount[]
}

model TraderProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  traderType  TraderType
  mainMarket  String?    // e.g. "NQ", "ES", "CL"
  platform    String?    // e.g. "NinjaTrader", "Rithmic"
  goal        TraderGoal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PropFirmAccount {
  id               String          @id @default(cuid())
  userId           String
  templateId       String?
  firmName         String
  accountSize      Float
  productType      PropProductType @default(EVALUATION)
  dailyLossLimit   Float           // effective daily loss limit in dollars
  eodFlatRule      Boolean         @default(false)
  trailingDrawdown Boolean         @default(false)
  consistencyRule  Boolean         @default(false)
  payoutMode       Boolean         @default(false)
  isActive         Boolean         @default(true)
  notes            String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   PropFirmTemplate? @relation(fields: [templateId], references: [id])
  guardrails Guardrails?
  sessions   TradingSession[]
}

model Guardrails {
  id                      String  @id @default(cuid())
  userId                  String
  accountId               String  @unique
  maxDailyLoss            Float?  // personal tighter limit; null = use firm limit
  maxTradesPerDay         Int?
  maxTradesCount          Int?    // max N trades...
  maxTradesWindowMin      Int?    // ...within this many minutes
  maxConsecutiveLosses    Int?
  cooldownAfterLossMin    Int?
  noTradeAfterHour        Int?    // 24h exchange time, e.g. 15 = no trades after 3pm ET
  noSizeIncreaseAfterLoss Boolean @default(false)
  payoutModeEnabled       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model TradingSession {
  id                String              @id @default(cuid())
  userId            String
  accountId         String
  date              DateTime            @db.Date
  status            SessionStatus       @default(ACTIVE)
  safetyStatus      AccountSafetyStatus @default(SAFE)
  tradesCount       Int                 @default(0)
  dailyPnl          Float               @default(0)
  dailyLossUsed     Float               @default(0) // positive = dollars of loss consumed
  disciplineScore   Int?
  payoutSafetyScore Int?
  notes             String?             @db.Text
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  events  DisciplineEvent[]

  @@unique([userId, accountId, date])
}

model DisciplineEvent {
  id        String              @id @default(cuid())
  sessionId String
  userId    String
  type      DisciplineEventType
  severity  DisciplineSeverity  @default(WARNING)
  message   String              @db.Text
  data      Json?

  createdAt DateTime @default(now())

  session TradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}
